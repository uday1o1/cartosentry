{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "minimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_key": {
          "minLength": 1,
          "title": "Source Key",
          "type": "string"
        }
      },
      "required": [
        "source_key",
        "sha256",
        "byte_count",
        "media_type"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "LocalRunContext": {
      "additionalProperties": false,
      "properties": {
        "host_name": {
          "minLength": 1,
          "title": "Host Name",
          "type": "string"
        },
        "machine_id": {
          "minLength": 1,
          "title": "Machine Id",
          "type": "string"
        },
        "source_roots": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Roots",
          "type": "array"
        }
      },
      "required": [
        "source_roots",
        "host_name",
        "machine_id"
      ],
      "title": "LocalRunContext",
      "type": "object"
    },
    "StageRecord": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attempt Id"
        },
        "output_hashes": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:-]*$": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "title": "Output Hashes",
          "type": "object"
        },
        "state": {
          "$ref": "#/$defs/StageState"
        }
      },
      "required": [
        "state",
        "attempt_id",
        "output_hashes"
      ],
      "title": "StageRecord",
      "type": "object"
    },
    "StageState": {
      "enum": [
        "PENDING",
        "RUNNING",
        "COMPLETE",
        "FAILED_RETRYABLE",
        "FAILED_FINAL",
        "INVALIDATED",
        "SKIPPED_NOT_APPLICABLE"
      ],
      "title": "StageState",
      "type": "string"
    }
  },
  "$id": "https://schemas.cartosentry.dev/cartosentry.run.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "configuration_hashes": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.:-]*$": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "title": "Configuration Hashes",
      "type": "object"
    },
    "engine_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Engine Version",
      "type": "string"
    },
    "local_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalRunContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profile_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Profile Id",
      "type": "string"
    },
    "road_graph_id": {
      "pattern": "^[a-z][a-z0-9-]*-sha256-[0-9a-f]{64}$",
      "title": "Road Graph Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z][a-z0-9-]*-sha256-[0-9a-f]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "cartosentry.run.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence_id": {
      "pattern": "^[a-z][a-z0-9-]*-sha256-[0-9a-f]{64}$",
      "title": "Sequence Id",
      "type": "string"
    },
    "stages": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.:-]*$": {
          "$ref": "#/$defs/StageRecord"
        }
      },
      "title": "Stages",
      "type": "object"
    },
    "state": {
      "$ref": "#/$defs/StageState"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "sequence_id",
    "road_graph_id",
    "profile_id",
    "engine_version",
    "configuration_hashes",
    "state",
    "stages",
    "artifacts"
  ],
  "title": "Run",
  "type": "object"
}
