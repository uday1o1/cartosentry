{
  "$defs": {
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "derived_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Derived Artifact Sha256",
          "type": "string"
        },
        "detector_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Detector Version",
          "type": "string"
        },
        "frame_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]*-sha256-[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Frame Ids",
          "type": "array"
        },
        "source_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Artifact Sha256",
          "type": "string"
        },
        "source_interval": {
          "$ref": "#/$defs/SourceInterval"
        },
        "transformation_lineage": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Transformation Lineage",
          "type": "array"
        }
      },
      "required": [
        "source_artifact_sha256",
        "source_interval",
        "frame_ids",
        "derived_artifact_sha256",
        "detector_version",
        "transformation_lineage"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/MeasurementUnit"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value",
        "unit"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "MeasurementUnit": {
      "enum": [
        "ns",
        "m",
        "m/s",
        "m/s^2",
        "rad",
        "rad/s",
        "deg",
        "Hz",
        "count",
        "fraction",
        "bytes",
        "m^2",
        "1/m",
        "dB",
        "bool"
      ],
      "title": "MeasurementUnit",
      "type": "string"
    },
    "Observability": {
      "enum": [
        "OBSERVABLE",
        "WEAK",
        "NOT_OBSERVABLE",
        "NOT_APPLICABLE"
      ],
      "title": "Observability",
      "type": "string"
    },
    "RawTime": {
      "additionalProperties": false,
      "description": "Lossless source timestamp representation and conversion provenance.",
      "properties": {
        "decimal_lexeme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decimal Lexeme"
        },
        "encoded_bytes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encoded Bytes"
        },
        "encoding": {
          "$ref": "#/$defs/RawTimeEncoding"
        },
        "epoch": {
          "$ref": "#/$defs/TimeEpoch"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "integer_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Integer Value"
        },
        "maximum_conversion_error_ns": {
          "minimum": 0.0,
          "title": "Maximum Conversion Error Ns",
          "type": "number"
        },
        "reference": {
          "$ref": "#/$defs/TimeReference"
        },
        "rounding": {
          "$ref": "#/$defs/TimeRounding"
        },
        "source_key": {
          "minLength": 1,
          "title": "Source Key",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "source_key",
        "field",
        "unit",
        "epoch",
        "reference",
        "encoding",
        "rounding",
        "maximum_conversion_error_ns"
      ],
      "title": "RawTime",
      "type": "object"
    },
    "RawTimeEncoding": {
      "enum": [
        "decimal_lexeme",
        "signed_integer",
        "unsigned_integer",
        "encoded_bytes"
      ],
      "title": "RawTimeEncoding",
      "type": "string"
    },
    "ReadinessState": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ],
      "title": "ReadinessState",
      "type": "string"
    },
    "RootCauseHypothesis": {
      "additionalProperties": false,
      "properties": {
        "confirmed": {
          "const": false,
          "default": false,
          "title": "Confirmed",
          "type": "boolean"
        },
        "contradicting_evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Contradicting Evidence",
          "type": "array"
        },
        "possible_cause": {
          "minLength": 1,
          "title": "Possible Cause",
          "type": "string"
        },
        "supporting_evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Supporting Evidence",
          "type": "array"
        }
      },
      "required": [
        "possible_cause",
        "supporting_evidence",
        "contradicting_evidence"
      ],
      "title": "RootCauseHypothesis",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "INFO",
        "WARNING",
        "CRITICAL",
        "BLOCKING_ANALYSIS"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceInterval": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "$ref": "#/$defs/TimePoint"
        },
        "start": {
          "$ref": "#/$defs/TimePoint"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "SourceInterval",
      "type": "object"
    },
    "Threshold": {
      "additionalProperties": false,
      "properties": {
        "charter_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Charter Key",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/ThresholdOperator"
        },
        "unit": {
          "$ref": "#/$defs/MeasurementUnit"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "operator",
        "value",
        "unit",
        "charter_key"
      ],
      "title": "Threshold",
      "type": "object"
    },
    "ThresholdOperator": {
      "enum": [
        "lt",
        "le",
        "gt",
        "ge",
        "abs_le",
        "eq"
      ],
      "title": "ThresholdOperator",
      "type": "string"
    },
    "TimeEpoch": {
      "enum": [
        "UNIX_UTC",
        "GPS",
        "SENSOR_BOOT",
        "HOST_MONOTONIC",
        "UNKNOWN"
      ],
      "title": "TimeEpoch",
      "type": "string"
    },
    "TimePoint": {
      "additionalProperties": false,
      "description": "Tagged canonical timestamp with exact signed-int64 nanoseconds.",
      "properties": {
        "clock_id": {
          "minLength": 1,
          "title": "Clock Id",
          "type": "string"
        },
        "epoch": {
          "$ref": "#/$defs/TimeEpoch"
        },
        "raw": {
          "$ref": "#/$defs/RawTime"
        },
        "reference": {
          "$ref": "#/$defs/TimeReference"
        },
        "value_ns": {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "title": "Value Ns",
          "type": "integer"
        }
      },
      "required": [
        "value_ns",
        "epoch",
        "clock_id",
        "reference",
        "raw"
      ],
      "title": "TimePoint",
      "type": "object"
    },
    "TimeReference": {
      "enum": [
        "EXPOSURE_START",
        "EXPOSURE_MIDPOINT",
        "EXPOSURE_END",
        "SCAN_START",
        "SCAN_MIDPOINT",
        "SCAN_END",
        "SAMPLE",
        "PER_POINT",
        "PER_AZIMUTH",
        "UNKNOWN"
      ],
      "title": "TimeReference",
      "type": "string"
    },
    "TimeRounding": {
      "enum": [
        "exact",
        "nearest_nanosecond_half_away_from_zero"
      ],
      "title": "TimeRounding",
      "type": "string"
    }
  },
  "$id": "https://schemas.cartosentry.dev/cartosentry.finding.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "detector_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Detector Id",
      "type": "string"
    },
    "detector_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Detector Version",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "title": "Evidence",
      "type": "array"
    },
    "finding_id": {
      "pattern": "^[a-z][a-z0-9-]*-sha256-[0-9a-f]{64}$",
      "title": "Finding Id",
      "type": "string"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/RootCauseHypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "interval": {
      "$ref": "#/$defs/SourceInterval"
    },
    "measurement": {
      "$ref": "#/$defs/Measurement"
    },
    "observability": {
      "$ref": "#/$defs/Observability"
    },
    "readiness_effect": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReadinessState"
        },
        {
          "type": "null"
        }
      ]
    },
    "remediation": {
      "minLength": 1,
      "title": "Remediation",
      "type": "string"
    },
    "road_bin_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9-]*-sha256-[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Road Bin Ids",
      "type": "array"
    },
    "rule_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Rule Id",
      "type": "string"
    },
    "schema_version": {
      "const": "cartosentry.finding.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "streams": {
      "items": {
        "pattern": "^stream-[a-z0-9-]+-[a-z0-9-]+-[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Streams",
      "type": "array"
    },
    "threshold": {
      "$ref": "#/$defs/Threshold"
    }
  },
  "required": [
    "schema_version",
    "finding_id",
    "detector_id",
    "detector_version",
    "rule_id",
    "severity",
    "observability",
    "readiness_effect",
    "streams",
    "interval",
    "measurement",
    "threshold",
    "road_bin_ids",
    "evidence",
    "hypotheses",
    "remediation"
  ],
  "title": "Finding",
  "type": "object"
}
