{
  "$defs": {
    "Reachability": {
      "enum": [
        "REACHABLE",
        "DEFERRED",
        "UNREACHABLE"
      ],
      "title": "Reachability",
      "type": "string"
    },
    "ReadinessState": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ],
      "title": "ReadinessState",
      "type": "string"
    },
    "RecaptureRequirement": {
      "additionalProperties": false,
      "properties": {
        "directed_arc_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Directed Arc Id",
          "type": "string"
        },
        "end_offset_m": {
          "minimum": 0.0,
          "title": "End Offset M",
          "type": "number"
        },
        "minimum_continuous_observation_m": {
          "exclusiveMinimum": 0.0,
          "title": "Minimum Continuous Observation M",
          "type": "number"
        },
        "priority_weight": {
          "minimum": 0,
          "title": "Priority Weight",
          "type": "integer"
        },
        "reachability": {
          "$ref": "#/$defs/Reachability"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "required_modality": {
          "$ref": "#/$defs/SensorModality"
        },
        "requirement_id": {
          "pattern": "^[a-z][a-z0-9-]*-sha256-[0-9a-f]{64}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "road_bin_id": {
          "pattern": "^[a-z][a-z0-9-]*-sha256-[0-9a-f]{64}$",
          "title": "Road Bin Id",
          "type": "string"
        },
        "sensor_warmup_m": {
          "minimum": 0.0,
          "title": "Sensor Warmup M",
          "type": "number"
        },
        "start_offset_m": {
          "minimum": 0.0,
          "title": "Start Offset M",
          "type": "number"
        },
        "traversal_direction": {
          "enum": [
            "FORWARD",
            "REVERSE"
          ],
          "title": "Traversal Direction",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "road_bin_id",
        "directed_arc_id",
        "start_offset_m",
        "end_offset_m",
        "required_modality",
        "traversal_direction",
        "minimum_continuous_observation_m",
        "sensor_warmup_m",
        "priority_weight",
        "reason",
        "reachability"
      ],
      "title": "RecaptureRequirement",
      "type": "object"
    },
    "RouteBudget": {
      "additionalProperties": false,
      "properties": {
        "maximum_distance_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maximum Distance M"
        },
        "maximum_duration_ns": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maximum Duration Ns"
        }
      },
      "required": [
        "maximum_distance_m",
        "maximum_duration_ns"
      ],
      "title": "RouteBudget",
      "type": "object"
    },
    "SensorModality": {
      "enum": [
        "camera",
        "gnss",
        "imu",
        "lidar",
        "radar",
        "trajectory"
      ],
      "title": "SensorModality",
      "type": "string"
    }
  },
  "$id": "https://schemas.cartosentry.dev/cartosentry.recapture-plan.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "budget": {
      "anyOf": [
        {
          "$ref": "#/$defs/RouteBudget"
        },
        {
          "type": "null"
        }
      ]
    },
    "covered_requirement_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9-]*-sha256-[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Covered Requirement Ids",
      "type": "array"
    },
    "deferred_requirement_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9-]*-sha256-[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Deferred Requirement Ids",
      "type": "array"
    },
    "depot_node_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Depot Node Id",
      "type": "string"
    },
    "estimated_distance_m": {
      "minimum": 0.0,
      "title": "Estimated Distance M",
      "type": "number"
    },
    "estimated_duration_ns": {
      "minimum": 0,
      "title": "Estimated Duration Ns",
      "type": "integer"
    },
    "recapture_plan_id": {
      "pattern": "^[a-z][a-z0-9-]*-sha256-[0-9a-f]{64}$",
      "title": "Recapture Plan Id",
      "type": "string"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/RecaptureRequirement"
      },
      "title": "Requirements",
      "type": "array"
    },
    "road_graph_id": {
      "pattern": "^[a-z][a-z0-9-]*-sha256-[0-9a-f]{64}$",
      "title": "Road Graph Id",
      "type": "string"
    },
    "route_arc_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Route Arc Ids",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[a-z][a-z0-9-]*-sha256-[0-9a-f]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "cartosentry.recapture-plan.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "unreachable_requirement_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9-]*-sha256-[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Unreachable Requirement Ids",
      "type": "array"
    },
    "validation_state": {
      "$ref": "#/$defs/ReadinessState"
    }
  },
  "required": [
    "schema_version",
    "recapture_plan_id",
    "run_id",
    "road_graph_id",
    "depot_node_id",
    "requirements",
    "route_arc_ids",
    "covered_requirement_ids",
    "deferred_requirement_ids",
    "unreachable_requirement_ids",
    "estimated_distance_m",
    "estimated_duration_ns",
    "budget",
    "validation_state"
  ],
  "title": "RecapturePlan",
  "type": "object"
}
